<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.ModuleInstructorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автошкола — Панель инструктора"
        Height="780"
        Width="1250"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}"
        Foreground="{DynamicResource TextColor}"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Кнопки бокового меню -->
        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#D8DED8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3B4742"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#536158"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Карточки -->
        <Style x:Key="StatCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>


        <!-- Кнопки действий -->
        <Style x:Key="InstructorActionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource AccentButtonStyle}">

            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="17,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Боковое меню -->
        <Border Grid.Column="0"
                Background="{DynamicResource ForestCharcoal}">

            <DockPanel Margin="20">

                <!-- Нижняя часть меню -->
                <StackPanel DockPanel.Dock="Bottom">

                    <Border Height="1"
                            Background="#536158"
                            Margin="0,15,0,12"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="Logout_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↪"
                                       Width="25"
                                       FontSize="17"
                                       Foreground="#D99B8F"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Выйти"
                                       Foreground="#D99B8F"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>


                <!-- Основное меню -->
                <StackPanel>

                    <!-- Название приложения -->
                    <StackPanel Margin="5,8,0,38">

                        <TextBlock Text="АВТОШКОЛА"
                                   Foreground="#F3F1EB"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Text="ПАНЕЛЬ ИНСТРУКТОРА"
                                   Foreground="#A8B5A5"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- Главное -->
                    <TextBlock Text="ГЛАВНОЕ"
                               Foreground="#A8B5A5"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="10,0,0,10"/>

                    <Button x:Name="DashboardButton"
                            Style="{StaticResource NavButtonStyle}"
                            Background="{DynamicResource Sage}"
                            Foreground="{DynamicResource ForestCharcoal}"
                            Click="Dashboard_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂"
                                       Width="25"
                                       FontSize="19"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Главная"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>


                    <!-- Работа -->
                    <TextBlock Text="РАБОТА"
                               Foreground="#A8B5A5"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="10,25,0,10"/>

                    <Button x:Name="LessonsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Lessons_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦"
                                       Width="25"
                                       FontSize="18"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Моё расписание"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="StudentsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Students_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♙"
                                       Width="25"
                                       FontSize="18"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Мои ученики"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>


                    <!-- Личные данные -->
                    <Border Height="1"
                            Background="#536158"
                            Margin="10,18,10,12"/>

                    <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ"
                               Foreground="#A8B5A5"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="10,0,0,10"/>

                    <Button x:Name="ProfileButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Profile_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◉"
                                       Width="25"
                                       FontSize="18"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Мой профиль"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>


        <!-- Основная область -->
        <Grid Grid.Column="1"
              Margin="32,25,32,25">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- Верхняя панель -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Панель инструктора"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>

                    <TextBlock Text="Управление занятиями и учениками"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               Margin="0,4,0,0"/>

                </StackPanel>


                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15,9"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#7E9B7B"
                                 VerticalAlignment="Center"
                                 Margin="0,0,9,0"/>

                        <TextBlock Text="Инструктор"
                                   Foreground="{DynamicResource TextColor}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                    </StackPanel>
                </Border>
            </Grid>


            <!-- Рабочая область -->
            <Grid Grid.Row="1"
                  Margin="0,20,0,0">


                <!-- Главная -->
                <ScrollViewer x:Name="DashboardPanel"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Добро пожаловать!"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                        <TextBlock Text="Здесь вы можете следить за своими занятиями и учениками."
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,7,0,25"
                                   TextWrapping="Wrap"/>


                        <!-- Статистика -->
                        <UniformGrid Columns="2"
                                     Margin="0,0,0,22">

                            <Border Style="{StaticResource StatCardStyle}"
                                    Margin="0,0,12,0">

                                <StackPanel>

                                    <TextBlock Text="МОИ УЧЕНИКИ"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>
                                    <TextBlock x:Name="StudentsCountText"
                                               Text="0"
                                               FontSize="32"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColor}"
                                               Margin="0,10,0,0"/>

                                    <TextBlock Text="Закреплено за вами"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                </StackPanel>
                            </Border>


                            <Border Style="{StaticResource StatCardStyle}"
                                    Margin="6,0,0,0">

                                <StackPanel>

                                    <TextBlock Text="МОИ ЗАНЯТИЯ"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                    <TextBlock x:Name="LessonsCountText"
                                               Text="0"
                                               FontSize="32"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColor}"
                                               Margin="0,10,0,0"/>

                                    <TextBlock Text="Всего в расписании"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                </StackPanel>
                            </Border>

                        </UniformGrid>


                        <!-- Быстрый доступ -->
                        <Border Style="{StaticResource StatCardStyle}"
                                Padding="25">

                            <StackPanel>

                                <TextBlock Text="Быстрый доступ"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="Выберите раздел для работы с расписанием или учениками."
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextColor}"
                                           TextWrapping="Wrap"/>

                                <WrapPanel Margin="0,20,0,0">

                                    <Button Content="Моё расписание"
                                            Style="{StaticResource InstructorActionButtonStyle}"
                                            Margin="0,0,10,10"
                                            Click="Lessons_Click"/>

                                    <Button Content="Мои ученики"
                                            Style="{StaticResource InstructorActionButtonStyle}"
                                            Margin="0,0,10,10"
                                            Click="Students_Click"/>

                                    <Button Content="Мой профиль"
                                            Style="{StaticResource InstructorActionButtonStyle}"
                                            Margin="0,0,10,10"
                                            Click="Profile_Click"/>

                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>


                <!-- Разделы -->
                <Border x:Name="SectionPanel"
                        Visibility="Collapsed"
                        Background="{DynamicResource SurfaceColor}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Padding="30">

                    <StackPanel VerticalAlignment="Top">

                        <TextBlock x:Name="SectionTitle"
                                   Text="Раздел"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                        <TextBlock x:Name="SectionDescription"
                                   Text="Описание раздела"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,10,0,25"
                                   TextWrapping="Wrap"/>

                        <Border Background="{DynamicResource BackgroundColor}"
                                CornerRadius="6"
                                Padding="20">

                            <TextBlock Text="Рабочая область раздела будет добавлена на следующем этапе."
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextColor}"
                                       TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>
