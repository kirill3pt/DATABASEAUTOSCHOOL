<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.ModuleInstructorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автошкола — Панель инструктора"
        Height="780"
        Width="1250"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Кнопки бокового меню -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#C5D0E3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder"
                                        Property="Background"
                                        Value="#344568"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder"
                                        Property="Background"
                                        Value="#4169E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточки -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- БОКОВОЕ МЕНЮ -->
        <Border Grid.Column="0" Background="#202B46">
            <DockPanel Margin="20">

                <!-- Нижняя часть -->
                <StackPanel DockPanel.Dock="Bottom">

                    <Border Height="1"
                            Background="#3A4864"
                            Margin="0,15"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="Logout_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↪"
                                       Width="25"
                                       FontSize="17"
                                       Foreground="#F08A8A"/>
                            <TextBlock Text="Выйти"
                                       Foreground="#F08A8A"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- Основное меню -->
                <StackPanel>

                    <!-- Логотип -->
                    <StackPanel Margin="5,8,0,35">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚘"
                                       FontSize="25"
                                       Margin="0,0,9,0"
                                       VerticalAlignment="Center"/>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DRIVING SCHOOL"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="Bold"/>

                                <TextBlock Text="INSTRUCTOR PANEL"
                                           Foreground="#8999B8"
                                           FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Главное -->
                    <TextBlock Text="ГЛАВНОЕ"
                               Foreground="#7888A5"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="10,0,0,10"/>

                    <Button x:Name="DashboardButton"
                            Style="{StaticResource NavButtonStyle}"
                            Background="#4169E1"
                            Foreground="White"
                            Click="Dashboard_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂"
                                       Width="25"
                                       FontSize="19"
                                       Foreground="White"/>
                            <TextBlock Text="Главная"
                                       Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- Работа -->
                    <TextBlock Text="РАБОТА"
                               Foreground="#7888A5"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="10,25,0,10"/>

                    <Button x:Name="LessonsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Lessons_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦"
                                       Width="25"
                                       FontSize="18"
                                       Foreground="#C5D0E3"/>
                            <TextBlock Text="Моё расписание"
                                       Foreground="#C5D0E3"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="StudentsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Students_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♙"
                                       Width="25"
                                       FontSize="18"
                                       Foreground="#C5D0E3"/>
                            <TextBlock Text="Мои ученики"
                                       Foreground="#C5D0E3"/>
                        </StackPanel>
                    </Button>

                    <!-- Дополнительно -->
                    <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ"
                               Foreground="#7888A5"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="10,25,0,10"/>

                    <Button x:Name="ProfileButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Profile_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◉"
                                       Width="25"
                                       FontSize="18"
                                       Foreground="#C5D0E3"/>
                            <TextBlock Text="Мой профиль"
                                       Foreground="#C5D0E3"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ОСНОВНАЯ ЧАСТЬ -->
        <Grid Grid.Column="1" Margin="32,25,32,25">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Панель инструктора"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColor}"/>

                    <TextBlock Text="Управление занятиями и учениками"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextColor}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceColor}"
                        CornerRadius="10"
                        Padding="15,8"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9"
                                 Height="9"
                                 Fill="#38B879"
                                 VerticalAlignment="Center"
                                 Margin="0,0,9,0"/>

                        <TextBlock Text="Инструктор"
                                   Foreground="{StaticResource TextColor}"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- РАБОЧАЯ ОБЛАСТЬ -->
            <Grid Grid.Row="1" Margin="0,20,0,0">

                <!-- Главная -->
                <ScrollViewer x:Name="DashboardPanel"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Добро пожаловать!"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}"/>

                        <TextBlock Text="Здесь вы можете следить за своими занятиями и учениками."
                                   FontSize="14"
                                   Foreground="{StaticResource SecondaryTextColor}"
                                   Margin="0,7,0,25"/>

                        <!-- Статистика -->
                        <UniformGrid Columns="2" Margin="0,0,0,22">

                            <Border Style="{StaticResource StatCardStyle}"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="МОИ УЧЕНИКИ"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SecondaryTextColor}"/>

                                    <TextBlock Text="—"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextColor}"
                                               Margin="0,10,0,0"/>

                                    <TextBlock Text="Закреплено за вами"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextColor}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}"
                                    Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="МОИ ЗАНЯТИЯ"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SecondaryTextColor}"/>

                                    <TextBlock Text="—"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextColor}"
                                               Margin="0,10,0,0"/>

                                    <TextBlock Text="Всего в расписании"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextColor}"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <!-- Быстрый доступ -->
                        <Border Style="{StaticResource StatCardStyle}"
                                Padding="25">

                            <StackPanel>
                                <TextBlock Text="Быстрый доступ"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextColor}"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="Выберите раздел для работы с расписанием или учениками."
                                           FontSize="13"
                                           Foreground="{StaticResource SecondaryTextColor}"
                                           TextWrapping="Wrap"/>

                                <WrapPanel Margin="0,20,0,0">

                                    <Button Content="Моё расписание"
                                            Width="155"
                                            Height="40"
                                            Margin="0,0,10,10"
                                            Click="Lessons_Click"/>

                                    <Button Content="Мои ученики"
                                            Width="140"
                                            Height="40"
                                            Margin="0,0,10,10"
                                            Click="Students_Click"/>

                                    <Button Content="Мой профиль"
                                            Width="135"
                                            Height="40"
                                            Margin="0,0,10,10"
                                            Click="Profile_Click"/>

                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Разделы -->
                <Border x:Name="SectionPanel"
                        Visibility="Collapsed"
                        Background="{StaticResource SurfaceColor}"
                        CornerRadius="14"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        Padding="30">

                    <StackPanel VerticalAlignment="Top">

                        <TextBlock x:Name="SectionTitle"
                                   Text="Раздел"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}"/>

                        <TextBlock x:Name="SectionDescription"
                                   Text="Описание раздела"
                                   FontSize="14"
                                   Foreground="{StaticResource SecondaryTextColor}"
                                   Margin="0,10,0,25"
                                   TextWrapping="Wrap"/>

                        <Border Background="{StaticResource BackgroundColor}"
                                CornerRadius="10"
                                Padding="20">

                            <TextBlock Text="Рабочая область раздела будет добавлена на следующем этапе."
                                       FontSize="13"
                                       Foreground="{StaticResource SecondaryTextColor}"
                                       TextWrapping="Wrap"/>
                        </Border>

                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>
