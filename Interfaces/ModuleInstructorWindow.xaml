<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.ModuleInstructorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автошкола — Панель инструктора"
        Height="780"
        Width="1250"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}"
        Foreground="{DynamicResource TextColor}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/AdminStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Боковое меню -->
        <Border Grid.Column="0"
                Background="{DynamicResource ForestCharcoal}">

            <DockPanel Margin="20">

                <!-- Нижняя часть меню -->
                <StackPanel DockPanel.Dock="Bottom">

                    <Border Height="1"
                            Background="#536158"
                            Margin="0,15,0,12"/>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="Logout_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↪"
                                       Width="25"
                                       FontSize="17"
                                       Foreground="#D99B8F"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Выйти"
                                       Foreground="#D99B8F"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>


                <!-- Основное меню -->
                <StackPanel>

                    <!-- Название приложения -->
                    <StackPanel Margin="5,8,0,38">

                        <TextBlock Text="АВТОШКОЛА"
                                   Foreground="#F3F1EB"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Text="ПАНЕЛЬ ИНСТРУКТОРА"
                                   Foreground="#A8B5A5"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- Главное -->
                    <TextBlock Text="ГЛАВНОЕ"
                               Foreground="#A8B5A5"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="10,0,0,10"/>

                    <Button x:Name="DashboardButton"
                            Style="{StaticResource NavButtonStyle}"
                            Background="{DynamicResource Sage}"
                            Foreground="{DynamicResource ForestCharcoal}"
                            Click="Dashboard_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Главная"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>


                    <!-- Работа -->
                    <TextBlock Text="РАБОТА"
                               Foreground="#A8B5A5"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="10,25,0,10"/>

                    <Button x:Name="LessonsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Lessons_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Моё расписание"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="StudentsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Students_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Мои ученики"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>


                    <!-- Личные данные -->
                    <Border Height="1"
                            Background="#536158"
                            Margin="10,18,10,12"/>

                    <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ"
                               Foreground="#A8B5A5"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="10,0,0,10"/>

                    <Button x:Name="ProfileButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Profile_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Мой профиль"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>


        <!-- Основная область -->
        <Grid Grid.Column="1"
              Margin="32,25,32,25">

            <!-- Рабочая область -->
            <Grid Grid.Row="1"
                  Margin="0,20,0,0">


                <!-- Главная -->

                <ScrollViewer x:Name="DashboardPanel"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <!-- Заголовок -->
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">

                                <TextBlock Text="ГЛАВНАЯ / ОБЗОР"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextColor}"/>

                                <TextBlock Text="Рабочая панель"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           Margin="0,5,0,0"/>

                                <TextBlock Text="Ваши ученики, занятия и рабочие инструменты"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Статус инструктора -->
                            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="15,9"
                    VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal">

                                    <Ellipse Width="8"
                             Height="8"
                             Fill="#7E9B7B"
                             VerticalAlignment="Center"
                             Margin="0,0,9,0"/>

                                    <TextBlock Text="Инструктор"
                               Foreground="{DynamicResource TextColor}"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Статистика -->
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Моя статистика"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>
                        </Grid>

                        <UniformGrid Columns="2"
                     Margin="0,0,0,28">

                            <!-- Ученики -->
                            <Border Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="19"
                    Margin="0,0,8,0">

                                <StackPanel>

                                    <TextBlock Text="01 / УЧЕНИКИ"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                    <TextBlock x:Name="StudentsCountText"
                               Text="0"
                               FontSize="34"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               Margin="0,14,0,3"/>

                                    <TextBlock Text="Закреплено за вами"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextColor}"/>
                                </StackPanel>
                            </Border>

                            <!-- Занятия -->
                            <Border Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="19"
                    Margin="8,0,0,0">

                                <StackPanel>

                                    <TextBlock Text="02 / ЗАНЯТИЯ"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                    <TextBlock x:Name="LessonsCountText"
                               Text="0"
                               FontSize="34"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               Margin="0,14,0,3"/>

                                    <TextBlock Text="Всего в расписании"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextColor}"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <!-- Управление -->
                        <Grid Margin="0,0,0,15">
                            <StackPanel>

                                <TextBlock Text="Управление"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"/>

                                <TextBlock Text="Выберите необходимый раздел"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Плитки -->
                        <UniformGrid Columns="2">

                            <!-- Расписание -->
                            <Button Style="{StaticResource DashboardTileButtonStyle}"
                    Margin="0,0,8,8"
                    Click="Lessons_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="46"
                            Height="46"
                            Background="{DynamicResource MutedSurfaceColor}"
                            CornerRadius="10">

                                        <TextBlock Text="01"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                Margin="14,0,5,0"
                                VerticalAlignment="Center">

                                        <TextBlock Text="Моё расписание"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                                        <TextBlock Text="Просмотр занятий"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                               Text="→"
                               FontSize="20"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Ученики -->
                            <Button Style="{StaticResource DashboardTileButtonStyle}"
                    Margin="8,0,0,8"
                    Click="Students_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="46"
                            Height="46"
                            Background="{DynamicResource MutedSurfaceColor}"
                            CornerRadius="10">

                                        <TextBlock Text="02"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                Margin="14,0,5,0"
                                VerticalAlignment="Center">

                                        <TextBlock Text="Мои ученики"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                                        <TextBlock Text="Информация об учениках"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                               Text="→"
                               FontSize="20"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Профиль -->
                            <Button Style="{StaticResource DashboardTileButtonStyle}"
                    Margin="0,8,8,0"
                    Click="Profile_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="46"
                            Height="46"
                            Background="{DynamicResource MutedSurfaceColor}"
                            CornerRadius="10">

                                        <TextBlock Text="03"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                Margin="14,0,5,0"
                                VerticalAlignment="Center">

                                        <TextBlock Text="Мой профиль"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                                        <TextBlock Text="Личные данные"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                               Text="→"
                               FontSize="20"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                        </UniformGrid>

                    </StackPanel>
                </ScrollViewer>


                <!-- Разделы -->
                <Border x:Name="SectionPanel"
                        Visibility="Collapsed"
                        Background="{DynamicResource SurfaceColor}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Padding="30">

                    <StackPanel VerticalAlignment="Top">

                        <TextBlock x:Name="SectionTitle"
                                   Text="Раздел"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                        <TextBlock x:Name="SectionDescription"
                                   Text="Описание раздела"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,10,0,25"
                                   TextWrapping="Wrap"/>

                        <Border Background="{DynamicResource BackgroundColor}"
                                CornerRadius="6"
                                Padding="20">

                            <TextBlock Text="Рабочая область раздела будет добавлена на следующем этапе."
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextColor}"
                                       TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>
