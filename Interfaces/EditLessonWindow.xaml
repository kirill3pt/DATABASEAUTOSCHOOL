<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.EditLessonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование занятия"
        Width="500"
        Height="820"
        MinWidth="500"
        MinHeight="820"
        MaxWidth="500"
        MaxHeight="820"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="CalendarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FAF9F6"/>
            <Setter Property="Foreground" Value="#293330"/>
            <Setter Property="BorderBrush" Value="#E2E0D8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#EAE8E0"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#A8B5A5"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="#B8B8B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">

            <TextBlock Text="Редактирование занятия"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextColor}"/>

            <TextBlock Text="Измените информацию о занятии"
                       FontSize="13"
                       Foreground="{StaticResource SecondaryTextColor}"
                       Margin="0,6,0,0"/>

        </StackPanel>

        <!-- Основные поля -->
        <StackPanel Grid.Row="1">

            <TextBlock Text="Ученик"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="StudentBox"
                      Height="40"
                      FontSize="14"
                      Margin="0,0,0,15"
                      SelectedValuePath="ID"
                      TextSearch.TextPath="FIO">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FIO}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

            </ComboBox>

            <TextBlock Text="Инструктор"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="InstructorBox"
                      Height="40"
                      FontSize="14"
                      Margin="0,0,0,15"
                      SelectedValuePath="ID"
                      TextSearch.TextPath="FIO">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FIO}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

            </ComboBox>

            <TextBlock Text="Автомобиль"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="CarBox"
                      Height="40"
                      FontSize="14"
                      Margin="0,0,0,15"
                      SelectedValuePath="ID"
                      TextSearch.TextPath="CarName">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding CarName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

            </ComboBox>

            <!-- Дата занятия -->
            <TextBlock Text="Дата занятия"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <Grid x:Name="DateField" Margin="0,0,0,15">

                <Border Height="42"
                        Background="#FBFAF7"
                        BorderBrush="#E2E0D8"
                        BorderThickness="1"
                        CornerRadius="6"/>

                <Button Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CalendarToggleButton_Click">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SelectedDateText"
                                   Grid.Column="0"
                                   Text="Выберите дату"
                                   FontSize="14"
                                   Foreground="#293330"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="12,0,0,0"/>

                        <TextBlock Grid.Column="1"
                                   Text="▦"
                                   FontSize="19"
                                   Foreground="#737D76"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                </Button>

                <!-- Календарь -->
                <Popup x:Name="LessonCalendarPopup"
                       PlacementTarget="{Binding ElementName=DateField}"
                       Placement="Bottom"
                       VerticalOffset="5"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">

                    <Border Width="310"
                            Background="#FAF9F6"
                            BorderBrush="#E2E0D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15">

                        <StackPanel>

                            <Grid Margin="0,0,0,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="‹"
                                        FontSize="24"
                                        Style="{StaticResource CalendarButtonStyle}"
                                        Click="PreviousMonth_Click"/>

                                <TextBlock x:Name="CalendarMonthText"
                                           Grid.Column="1"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#293330"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="2"
                                        Content="›"
                                        FontSize="24"
                                        Style="{StaticResource CalendarButtonStyle}"
                                        Click="NextMonth_Click"/>

                            </Grid>

                            <UniformGrid Columns="7" Margin="0,0,0,7">
                                <TextBlock Text="Пн" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Вт" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Ср" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Чт" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Пт" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Сб" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Вс" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                            </UniformGrid>

                            <UniformGrid x:Name="CalendarDaysPanel"
                                         Columns="7"/>

                        </StackPanel>
                    </Border>
                </Popup>

            </Grid>

            <!-- Время -->
            <TextBlock Text="Время начала"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <Grid Margin="0,0,0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Часы"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextColor}"
                               Margin="0,0,0,5"/>

                    <ComboBox x:Name="HourBox"
                              Height="42"
                              FontSize="15"
                              Background="#FBFAF7"
                              Foreground="#293330"/>

                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text=":"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextColor}"
                           VerticalAlignment="Bottom"
                           Margin="12,0,12,8"/>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="Минуты"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextColor}"
                               Margin="0,0,0,5"/>

                    <ComboBox x:Name="MinuteBox"
                              Height="42"
                              FontSize="15"
                              Background="#FBFAF7"
                              Foreground="#293330"/>

                </StackPanel>

            </Grid>

            <!-- Продолжительность -->
            <TextBlock Text="Продолжительность"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <TextBox Height="40"
                     FontSize="14"
                     Margin="0,0,0,15"
                     Text="90 минут"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"/>

            <!-- Статус -->
            <TextBlock Text="Статус занятия"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="StatusBox"
                      Height="40"
                      FontSize="14"
                      SelectedIndex="0">

                <ComboBoxItem Content="запланировано"/>
                <ComboBoxItem Content="проведено"/>
                <ComboBoxItem Content="отменено"/>

            </ComboBox>

        </StackPanel>

        <!-- Кнопки -->
        <Grid Grid.Row="2" Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Отмена"
                    Width="105"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="{DynamicResource Sage}"
                    Foreground="{StaticResource TextColor}"
                    BorderThickness="0"
                    IsCancel="True"
                    Cursor="Hand"/>

            <Button Grid.Column="2"
                    Content="Сохранить"
                    Width="120"
                    Height="40"
                    Background="{StaticResource PrimaryColor}"
                    Foreground="#FAF9F6"
                    BorderThickness="0"
                    Click="SaveButton_Click"
                    Cursor="Hand"/>

        </Grid>

    </Grid>

</Window>
