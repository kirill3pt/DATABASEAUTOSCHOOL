<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.AddInstructorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление инструктора"
        Width="460"
        Height="590"
        MinWidth="460"
        MinHeight="590"
        MaxWidth="460"
        MaxHeight="590"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}"
        FontFamily="Segoe UI">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">

            <TextBlock Text="Новый инструктор"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextColor}"/>

            <TextBlock Text="Заполните информацию об инструкторе"
                       FontSize="13"
                       Foreground="{StaticResource SecondaryTextColor}"
                       Margin="0,6,0,0"/>

        </StackPanel>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="1">

            <TextBlock Text="Фамилия"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="LastNameBox"
                     Height="40"
                     FontSize="14"
                     Margin="0,0,0,12"
                     Background="White"
                     Foreground="#202B46"
                     BorderBrush="#D5DCE8"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     MaxLength="100"/>

            <TextBlock Text="Имя"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="FirstNameBox"
                     Height="40"
                     FontSize="14"
                     Margin="0,0,0,12"
                     Background="White"
                     Foreground="#202B46"
                     BorderBrush="#D5DCE8"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     MaxLength="100"/>

            <TextBlock Text="Отчество"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="MiddleNameBox"
                     Height="40"
                     FontSize="14"
                     Margin="0,0,0,12"
                     Background="White"
                     Foreground="#202B46"
                     BorderBrush="#D5DCE8"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     MaxLength="100"/>

            <TextBlock Text="Телефон"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="PhoneBox"
                     Height="40"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     Background="#FBFAF7"
                     Foreground="#293330"
                     BorderBrush="#E2E0D8"
                     MaxLength="18"
                     PreviewTextInput="PhoneBox_PreviewTextInput"
                     PreviewKeyDown="PhoneBox_PreviewKeyDown"
                     TextChanged="PhoneBox_TextChanged"/>

        </StackPanel>

        <!-- Кнопки -->
        <Grid Grid.Row="2" Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Отмена"
                    Width="105"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="{DynamicResource Sage}"
                    Foreground="{StaticResource TextColor}"
                    BorderThickness="0"
                    IsCancel="True"
                    Click="Cancel_Click"
                    Cursor="Hand"/>

            <Button Grid.Column="2"
                    Content="Добавить"
                    Width="120"
                    Height="40"
                    Background="{StaticResource PrimaryColor}"
                    Foreground="#FAF9F6"
                    BorderThickness="0"
                    Click="Save_Click"
                    Cursor="Hand"/>

        </Grid>

    </Grid>

</Window>
