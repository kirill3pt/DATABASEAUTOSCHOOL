<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.RegisterInstructorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация инструктора"
        Width="480"
        Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="AdminActionButtonStyle"
   TargetType="{x:Type Button}"
   BasedOn="{StaticResource AccentButtonStyle}">

            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="17,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

        </Style>
        <!-- Светлая кнопка -->
        <Style x:Key="LightActionButtonStyle"
   TargetType="{x:Type Button}"
   BasedOn="{StaticResource SecondaryButtonStyle}">

            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="17,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background"
        Value="{DynamicResource MutedSurfaceColor}"/>

        </Style>

    </Window.Resources>
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock Text="Регистрация"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>

            <TextBlock Text="Создание учётной записи инструктора"
                       FontSize="14"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       Margin="0,7,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,17">
            <TextBlock Text="Код приглашения"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"
                       Margin="0,0,0,7"/>

            <TextBox x:Name="InvitationCodeBox"
                     Height="43"
                     Padding="12,0"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBackgroundColor}"
                     Foreground="{DynamicResource TextColor}"
                     BorderBrush="{DynamicResource BorderColor}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,17">
            <TextBlock Text="Логин"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"
                       Margin="0,0,0,7"/>

            <TextBox x:Name="LoginBox"
                     Height="43"
                     Padding="12,0"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource InputBackgroundColor}"
                     Foreground="{DynamicResource TextColor}"
                     BorderBrush="{DynamicResource BorderColor}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,17">
            <TextBlock Text="Пароль"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"
                       Margin="0,0,0,7"/>

            <PasswordBox x:Name="PasswordBox"
                         Height="43"
                         Padding="12,0"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBackgroundColor}"
                         Foreground="{DynamicResource TextColor}"
                         BorderBrush="{DynamicResource BorderColor}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,25">
            <TextBlock Text="Повторите пароль"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"
                       Margin="0,0,0,7"/>

            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="43"
                         Padding="12,0"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBackgroundColor}"
                         Foreground="{DynamicResource TextColor}"
                         BorderBrush="{DynamicResource BorderColor}"/>
        </StackPanel>

        <StackPanel Grid.Row="5"
                    VerticalAlignment="Top">

            <Button Content="Зарегистрироваться"
                    Height="46"
                    Style="{StaticResource AdminActionButtonStyle}"
                    Click="Register_Click"/>

            <Button Content="Закрыть"
                    Height="42"
                    Margin="0,10,0,0"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="Close_Click"/>
        </StackPanel>

    </Grid>
</Window>
