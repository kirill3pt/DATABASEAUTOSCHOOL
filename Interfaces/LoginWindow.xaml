<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АВТОШКОЛА - Авторизация"
        Height="650"
        Width="1000"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextColor}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.12*"/>
            <ColumnDefinition Width="0.88*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая информационная область -->
        <Grid Grid.Column="0"
              Background="{DynamicResource ForestCharcoal}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,38,48,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="АВТОШКОЛА"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="#F3F1EB"/>
                    <TextBlock Text="ИНФОРМАЦИОННАЯ СИСТЕМА"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="#A8B5A5"
                            Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        Margin="48,0,42,0">

                <TextBlock Text="Панель"
                           FontSize="43"
                           FontWeight="SemiBold"
                           Foreground="#F3F1EB"
                           LineHeight="49"/>

                <TextBlock Text="авторизации"
                           FontSize="43"
                           FontWeight="SemiBold"
                           Foreground="#A8B5A5"
                           LineHeight="49"
                           Margin="0,-3,0,0"/>

                <Border Height="1"
                        Background="#53605A"
                        Margin="0,30,0,25"/>

                <TextBlock Text="ЕДИНАЯ СИСТЕМА УПРАВЛЕНИЯ"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#A8B5A5"
                           Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel/>

                    <StackPanel Grid.Column="1"/>
                </Grid>

                <StackPanel Margin="0,20,0,0"/>
            </StackPanel>

            <Grid Grid.Row="2"
                  Margin="48,0,48,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="БЕРЕЖЕЦКИЙ К.Т."
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#F3F1EB"/>
                    <TextBlock Text="ФТФ / ИВТ-2"
                               FontSize="9"
                               Foreground="#A8B5A5"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="2026"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#A8B5A5"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- Правая область авторизации -->
        <Grid Grid.Column="1"
              Background="{DynamicResource BackgroundColor}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="42,38,42,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ЛИЧНЫЙ КАБИНЕТ"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Row="1"
                        Width="340"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="Авторизация"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"/>

                <TextBlock Text="Войдите в систему, чтобы продолжить работу."
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           TextWrapping="Wrap"
                           Margin="0,9,0,32"/>

                <!-- Выбор роли -->
                <TextBlock Text="РОЛЬ"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           Margin="0,0,0,9"/>

                <ComboBox x:Name="roleBox"
                          Height="44"
                          FontSize="13"
                          SelectedIndex="0"
                          Padding="10,0"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,22">
                    <ComboBoxItem Content="Администратор"/>
                    <ComboBoxItem Content="Инструктор"/>
                </ComboBox>

                <!-- Логин -->
                <TextBlock Text="ЛОГИН"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           Margin="0,0,0,9"/>

                <TextBox x:Name="loginBox"
                         Height="44"
                         FontSize="13"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,22"/>

                <!-- Пароль -->
                <TextBlock Text="ПАРОЛЬ"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           Margin="0,0,0,9"/>

                <PasswordBox x:Name="passwordBox"
                             Height="44"
                             FontSize="13"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,30"/>

                <!-- Кнопки -->
                <Button x:Name="LoginButton"
                        Content="Войти в систему"
                        Height="46"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="LoginButton_Click"
                        Cursor="Hand"/>

                <Button x:Name="RegisterButton"
                        Content="Регистрация инструктора"
                        Height="44"
                        Margin="0,12,0,0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RegisterButton_Click"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
