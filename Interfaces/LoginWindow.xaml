<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автошкола — Авторизация"
        Height="650"
        Width="1000"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая информационная панель -->
        <Border Grid.Column="0" Background="#202B46">
            <Grid>
                <StackPanel VerticalAlignment="Center"
                            Margin="55">

                    <Border Background="#344568"
                            CornerRadius="10"
                            Padding="13,8"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,30">
                        <TextBlock Text="DRIVING SCHOOL"
                                   Foreground="#C5D5F5"
                                   FontSize="13"
                                   FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="Управляй&#10;своим будущим."
                               Foreground="White"
                               FontSize="40"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,22"/>

                    <TextBlock Text="Информационная система управления автошколой"
                               Foreground="#B9C5DA"
                               FontSize="16"
                               TextWrapping="Wrap"
                               LineHeight="25"/>

                    <Border Background="#344568"
                            CornerRadius="2"
                            Height="3"
                            Width="55"
                            HorizontalAlignment="Left"
                            Margin="0,35,0,0"/>
                </StackPanel>

                <TextBlock Text="АВТОШКОЛА • 2026"
                           Foreground="#72819E"
                           FontSize="11"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="55,0,0,30"/>
            </Grid>
        </Border>

        <!-- Правая часть -->
        <Grid Grid.Column="1">
            <Border Style="{StaticResource CardStyle}"
                    Width="365"
                    Padding="30"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Добро пожаловать"
                               FontSize="27"
                               FontWeight="Bold"/>

                    <TextBlock Text="Войдите в свою учётную запись"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextColor}"
                               Margin="0,7,0,30"/>

                    <TextBlock Text="Роль"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,0,8"/>

                    <ComboBox x:Name="roleBox"
                              SelectedIndex="0"
                              Margin="0,0,0,20">
                        <ComboBoxItem Content="Администратор"/>
                        <ComboBoxItem Content="Инструктор"/>
                    </ComboBox>

                    <TextBlock Text="Логин"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="loginBox"
                             Margin="0,0,0,20"/>

                    <TextBlock Text="Пароль"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,0,8"/>

                    <PasswordBox x:Name="passwordBox"
                                 Margin="0,0,0,25"/>

                    <Button Content="ВОЙТИ"
                            Height="46"
                            Click="LoginButton_Click"/>

                    <Button Content="Регистрация инструктора"
                            Height="40"
                            Margin="0,12,0,0"
                            Background="Transparent"
                            Foreground="{StaticResource PrimaryColor}"
                            BorderThickness="0"
                            Click="RegisterButton_Click"
                            Style="{x:Null}"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
