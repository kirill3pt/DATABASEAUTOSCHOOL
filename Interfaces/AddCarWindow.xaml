<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.AddCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление автомобиля"
        Width="460"
        Height="570"
        MinWidth="460"
        MinHeight="570"
        MaxWidth="460"
        MaxHeight="570"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}"
        FontFamily="Segoe UI">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">

            <TextBlock Text="Новый автомобиль"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextColor}"/>

            <TextBlock Text="Заполните информацию об автомобиле"
                       FontSize="13"
                       Foreground="{StaticResource SecondaryTextColor}"
                       Margin="0,6,0,0"/>

        </StackPanel>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="1">

            <TextBlock Text="Марка автомобиля"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="BrandBox"
                     Height="40"
                     FontSize="14"
                     Margin="0,0,0,15"
                     Background="White"
                     Foreground="#202B46"
                     BorderBrush="#D5DCE8"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     IsReadOnly="False"
                     IsEnabled="True"/>

            <TextBlock Text="Модель"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="ModelBox"
                     Height="40"
                     FontSize="14"
                     Margin="0,0,0,15"
                     Background="White"
                     Foreground="#202B46"
                     BorderBrush="#D5DCE8"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     IsReadOnly="False"
                     IsEnabled="True"/>

            <TextBlock Text="Государственный номер"
           FontWeight="SemiBold"
           Foreground="{StaticResource TextColor}"
           Margin="0,0,0,6"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Первая буква -->
                <TextBox x:Name="PlateLetterBox"
                        Grid.Column="0"
                        Height="40"
                        MaxLength="1"
                        Tag="Letters"
                        CharacterCasing="Upper"
                        FontSize="14"
                        TextAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="White"
                        Foreground="#202B46"
                        BorderBrush="#D5DCE8"
                        BorderThickness="1"
                        PreviewTextInput="Plate_PreviewTextInput"
                        PreviewKeyDown="Plate_PreviewKeyDown"
                        TextChanged="Plate_TextChanged"
                        DataObject.Pasting="Plate_Pasting"/>

                <!-- Три цифры -->
                <TextBox x:Name="PlateDigitsBox"
                        Grid.Column="1"
                        Height="40"
                        Margin="5,0,0,0"
                        MaxLength="3"
                        Tag="Digits"
                        FontSize="14"
                        TextAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="White"
                        Foreground="#202B46"
                        BorderBrush="#D5DCE8"
                        BorderThickness="1"
                        PreviewTextInput="Plate_PreviewTextInput"
                        PreviewKeyDown="Plate_PreviewKeyDown"
                        TextChanged="Plate_TextChanged"
                        DataObject.Pasting="Plate_Pasting"/>

                <!-- Две буквы -->
                <TextBox x:Name="PlateLettersBox"
                        Grid.Column="2"
                        Height="40"
                        Margin="5,0,0,0"
                        MaxLength="2"
                        Tag="Letters"
                        CharacterCasing="Upper"
                        FontSize="14"
                        TextAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="White"
                        Foreground="#202B46"
                        BorderBrush="#D5DCE8"
                        BorderThickness="1"
                        PreviewTextInput="Plate_PreviewTextInput"
                        PreviewKeyDown="Plate_PreviewKeyDown"
                        TextChanged="Plate_TextChanged"
                        DataObject.Pasting="Plate_Pasting"/>

                <!-- Разделитель -->
                <TextBlock Grid.Column="3"
                        Text="|"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SecondaryTextColor}"
                        VerticalAlignment="Center"
                        Margin="7,0"/>

                <!-- Регион: 2 или 3 цифры -->
                <TextBox x:Name="PlateRegionBox"
                        Grid.Column="4"
                        Height="40"
                        MaxLength="3"
                        Tag="Digits"
                        FontSize="14"
                        TextAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="White"
                        Foreground="#202B46"
                        BorderBrush="#D5DCE8"
                        BorderThickness="1"
                        PreviewTextInput="Plate_PreviewTextInput"
                        PreviewKeyDown="Plate_PreviewKeyDown"
                        TextChanged="Plate_TextChanged"
                        DataObject.Pasting="Plate_Pasting"/>
            </Grid>

            <TextBlock Text="Год выпуска"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="YearBox"
                     Height="40"
                     FontSize="14"
                     Background="White"
                     Foreground="#202B46"
                     BorderBrush="#D5DCE8"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     IsReadOnly="False"
                     IsEnabled="True"/>

        </StackPanel>

        <!-- Кнопки -->
        <Grid Grid.Row="2" Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Отмена"
                    Width="105"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="{DynamicResource Sage}"
                    Foreground="{StaticResource TextColor}"
                    BorderThickness="0"
                    IsCancel="True"
                    Cursor="Hand"/>

            <Button Grid.Column="2"
                    Content="Добавить"
                    Width="120"
                    Height="40"
                    Background="{StaticResource PrimaryColor}"
                    Foreground="#FAF9F6"
                    BorderThickness="0"
                    Click="SaveButton_Click"
                    Cursor="Hand"/>

        </Grid>

    </Grid>

</Window>
