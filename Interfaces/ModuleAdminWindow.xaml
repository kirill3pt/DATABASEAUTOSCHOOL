                    Style="{StaticResource DeleteActionButtonStyle}"
                    Click="DeletePayments_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Обновить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="RefreshPayments_Click"/>

