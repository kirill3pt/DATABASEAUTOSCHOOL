              Tag="Оплачен"
              Click="PaymentStatusMenuItem_Click"/>

                                        <MenuItem Header="Ожидает оплаты"
              Tag="Ожидает оплаты"
              Click="PaymentStatusMenuItem_Click"/>

                                        <MenuItem Header="Отменён"
              Tag="Отменён"
              Click="PaymentStatusMenuItem_Click"/>

                                    </ContextMenu>
                                </Button.ContextMenu>

                            </Button>


