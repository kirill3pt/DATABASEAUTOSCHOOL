            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Click="ExamCalendarToggleButton_Click">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="45"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock x:Name="ExamDateText"
                       Grid.Column="0"
                       Text="Выберите дату"
                       FontSize="14"
                       Foreground="#293330"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="12,0,0,0"/>

                                                <TextBlock Grid.Column="1"
                       Text="▦"
                       FontSize="19"
                       Foreground="#737D76"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>

                                        <Popup x:Name="ExamCalendarPopup"
           PlacementTarget="{Binding ElementName=ExamDateField}"
           Placement="Bottom"
           VerticalOffset="5"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade">

                                            <Border Width="310"
                Background="#FAF9F6"
                BorderBrush="#E2E0D8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15">

                                                <StackPanel>

                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="40"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button Grid.Column="0"
                            Content="‹"
                            FontSize="24"
                            Style="{StaticResource CalendarArrowButtonStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ExamPreviousMonth_Click"/>

                                                        <TextBlock x:Name="ExamCalendarMonthText"
                               Grid.Column="1"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#293330"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                                                        <Button Grid.Column="2"
                            Content="›"
                            FontSize="24"
                            Style="{StaticResource CalendarArrowButtonStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ExamNextMonth_Click"/>
                                                    </Grid>

                                                    <UniformGrid Columns="7"
                             Margin="0,0,0,7">
                                                        <TextBlock Text="Пн" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                                        <TextBlock Text="Вт" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                                        <TextBlock Text="Ср" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                                        <TextBlock Text="Чт" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                                        <TextBlock Text="Пт" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                                        <TextBlock Text="Сб" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                                        <TextBlock Text="Вс" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                                    </UniformGrid>

                                                    <UniformGrid x:Name="ExamCalendarDaysPanel"
                             Columns="7"/>

                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>


                                    <Button x:Name="GenerateExamListButton"
                        Content="Сформировать список"
                        Style="{StaticResource AdminActionButtonStyle}"
                        Click="GenerateExamList_Click"
                        Height="40"
                        Margin="0,12,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Заголовок списка -->
                        <Grid Grid.Row="1"
          Margin="0,0,0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Ученики группы"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>

                                <TextBlock Text="Список для регистрации участников экзамена"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                Background="{DynamicResource MutedSurfaceColor}"
                CornerRadius="8"
                Padding="12,7"
                VerticalAlignment="Center">

                                <TextBlock x:Name="ExamStudentsCountText"
                       Text="0 учеников"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>
                            </Border>
                        </Grid>

                        <!-- Таблица или пустое состояние -->
                        <Border Grid.Row="2"
            Background="{DynamicResource SurfaceColor}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="15">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок документа -->
                                <StackPanel Grid.Row="0"
                        Margin="5,0,5,15">

                                    <TextBlock x:Name="ExamListTitle"
                           Text="Экзаменационный список"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"/>

                                    <TextBlock x:Name="ExamListDate"
                           Text="Дата экзамена не указана"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Пустое состояние -->
                                <Border x:Name="ExamEmptyState"
                    Grid.Row="1"
                    Background="{DynamicResource MutedSurfaceColor}"
                    CornerRadius="8"
                    Padding="20">

                                    <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                                        <TextBlock Text="☷"
                               FontSize="42"
                               Foreground="{DynamicResource AccentColor}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                                        <TextBlock Text="Список ещё не сформирован"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               HorizontalAlignment="Center"/>

                                        <TextBlock Text="Выберите учебную группу и нажмите «Сформировать список»."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               TextAlignment="Center"
                               Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Таблица учеников -->
                                <DataGrid x:Name="ExamStudentsGrid"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      Style="{StaticResource ModernDataGridStyle}"
