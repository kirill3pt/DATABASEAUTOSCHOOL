                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="№"
                                        Binding="{Binding [№]}"
                                        Width="65"/>

                                        <DataGridTextColumn Header="ФИО ученика"
                                        Binding="{Binding [ФИО]}"
                                        Width="2*"/>

                                        <DataGridTextColumn Header="Подпись ученика"
                                        Binding="{Binding [Подпись]}"
                                        Width="2*"/>

                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Нижняя панель -->
                                <Grid Grid.Row="2"
                  Margin="5,15,5,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Подпись экзаменатора: __________________________"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextColor}"/>

                                    <Button x:Name="PrintExamListButton"
                        Grid.Column="1"
                        Content="Печать списка"
                        Style="{StaticResource AdminActionButtonStyle}"
                        Click="PrintExamList_Click"
                        Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>


                <!-- Раздел групп -->
                <Grid x:Name="GroupsPanel"
                       Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок и действия -->
                    <Grid Grid.Row="0"
          Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Учебные группы"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>

                            <TextBlock Text="Управление учебными группами автошколы"
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       Margin="0,5,0,15"/>

                            <TextBox x:Name="GroupSearchBox"
                     Width="280"
                     Height="38"
                     HorizontalAlignment="Left"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     FontSize="13"
                     TextChanged="GroupSearchBox_TextChanged"
                     ToolTip="Поиск по названию группы"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                            <Button Content="+ Добавить"
                    Style="{StaticResource AdminActionButtonStyle}"
                    Click="AddGroup_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Изменить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="EditGroup_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Удалить"
                    Style="{StaticResource DeleteActionButtonStyle}"
                    Click="DeleteGroup_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Обновить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="RefreshGroups_Click"/>

                        </StackPanel>
                    </Grid>

