<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.ModuleAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автошкола — Панель администратора"
        Height="780"
        Width="1250"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}"
        Foreground="{DynamicResource TextColor}"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Кнопки бокового меню -->
        <Style x:Key="NavButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#D7DED8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3B4742"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#536158"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Карточки статистики -->
        <Style x:Key="StatCardStyle"
               TargetType="{x:Type Border}">

            <Setter Property="Background"
                    Value="{DynamicResource SurfaceColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>

        </Style>


        <!-- Основная кнопка действий -->
        <Style x:Key="AdminActionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource AccentButtonStyle}">

            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="17,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

        </Style>


        <!-- Кнопка удаления -->
        <Style x:Key="DeleteActionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource AccentButtonStyle}">

            <Setter Property="Background"
                    Value="{DynamicResource DangerColor}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="17,8"/>
            <Setter Property="FontSize" Value="12"/>

        </Style>


        <!-- Светлая кнопка -->
        <Style x:Key="LightActionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SecondaryButtonStyle}">

            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="17,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background"
                    Value="{DynamicResource MutedSurfaceColor}"/>

        </Style>


        <!-- Таблица -->
        <Style x:Key="ModernDataGridStyle"
               TargetType="{x:Type DataGrid}">

            <Setter Property="Background"
                    Value="{DynamicResource SurfaceColor}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground"
                    Value="{DynamicResource SurfaceColor}"/>
            <Setter Property="AlternatingRowBackground"
                    Value="#F4F3EE"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="{DynamicResource BorderColor}"/>
            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>
            <Setter Property="RowHeight" Value="56"/>
            <Setter Property="ColumnHeaderHeight" Value="46"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>

            <!-- Заголовки столбцов -->
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridColumnHeader}">

                        <Setter Property="Background"
                                Value="{DynamicResource MutedSurfaceColor}"/>
                        <Setter Property="Foreground"
                                Value="{DynamicResource SecondaryTextColor}"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource BorderColor}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Cursor" Value="Hand"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">

                                        <ContentPresenter
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            RecognizesAccessKey="True"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="#EAE8E0"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextColor}"/>
                            </Trigger>

                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>


            <!-- Ячейки -->
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridCell}">

                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground"
                                Value="{DynamicResource TextColor}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type DataGridCell}">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="16,0">

                                        <ContentPresenter
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextColor}"/>
                                <Setter Property="Background"
                                        Value="Transparent"/>
                            </Trigger>

                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>


            <!-- Строки -->
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridRow}">

                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource BorderColor}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Background" Value="Transparent"/>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="#F0EFE8"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background"
                                        Value="#E7EBE4"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextColor}"/>
                            </Trigger>

                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Боковое меню -->
        <Border Grid.Column="0"
                Background="{DynamicResource ForestCharcoal}">

            <DockPanel Margin="20">

                <!-- Нижняя часть меню -->
                <StackPanel DockPanel.Dock="Bottom">
                    <!-- Дополнительные разделы -->
                    <TextBlock Text="ДОПОЛНИТЕЛЬНО"
                               Foreground="#A8B5A5"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="10,10,0,8"/>
                    <Border Height="1"
                            Background="#536158"
                            Margin="0,0,0,0"/>
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Settings_Click" Cursor="Hand">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Настройки"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="About_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="О программе"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Foreground="#D99B8F"
                            Click="Logout_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Выйти"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>


                <!-- Верхняя часть меню -->
                <StackPanel>

                    <!-- Название приложения -->
                    <StackPanel Margin="5,8,0,24">

                        <TextBlock Text="АВТОШКОЛА"
                                   Foreground="#F3F1EB"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Text="ПАНЕЛЬ УПРАВЛЕНИЯ"
                                   Foreground="#A8B5A5"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- Главная -->
                    <TextBlock Text="ГЛАВНОЕ"
                               Foreground="#A8B5A5"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="10,0,0,8"/>

                    <Button x:Name="DashboardButton"
                            Style="{StaticResource NavButtonStyle}"
                            Background="{DynamicResource Sage}"
                            Foreground="{DynamicResource ForestCharcoal}"
                            Click="Dashboard_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Главная"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Управление данными -->
                    <TextBlock Text="УПРАВЛЕНИЕ"
                               Foreground="#A8B5A5"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="10,10,0,8"/>
                    
                    <Button x:Name="GroupsButton"
                    Style="{StaticResource NavButtonStyle}"
                    Click="Groups_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Группы"
                               VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="StudentsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Students_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ученики"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>



                    <Button x:Name="InstructorsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Instructors_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Инструкторы"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CarsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Cars_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Автомобили"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="LessonsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Lessons_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Расписание"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PaymentsButton"
        Style="{StaticResource NavButtonStyle}"
        Click="Payments_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Платежи"
                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>



                    <Button x:Name="ReportsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Reports_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Отчёты"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>


        <!-- Основная область -->
        <Grid Grid.Column="1"
              Margin="32,25,32,25">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- Заголовок -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Панель администратора"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>

                    <TextBlock Text="Управление информационной системой автошколы"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               Margin="0,4,0,0"/>

                </StackPanel>


                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="15,9"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#7E9B7B"
                                 VerticalAlignment="Center"
                                 Margin="0,0,9,0"/>

                        <TextBlock Text="Администратор"
                                   Foreground="{DynamicResource TextColor}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                    </StackPanel>
                </Border>
            </Grid>


            <!-- Содержимое выбранного раздела -->
            <Grid Grid.Row="1"
                  Margin="0,20,0,0">


                <!-- Главная страница -->
                <ScrollViewer x:Name="DashboardPanel"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Добро пожаловать!"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                        <TextBlock Text="Здесь вы можете управлять основными данными автошколы."
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,7,0,25"
                                   TextWrapping="Wrap"/>


                        <!-- Статистика -->
                        <UniformGrid Columns="3"
                                     Margin="0,0,0,22">

                            <Border Style="{StaticResource StatCardStyle}"
                                    Margin="0,0,12,0">

                                <StackPanel>

                                    <TextBlock Text="УЧЕНИКИ"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>


                                    <TextBlock x:Name="StudentsCountText"
                                                Text="0"
                                                FontSize="24"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextColor}"
                                                Margin="0,10,0,0"/>

                                    <TextBlock Text="Всего в системе"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                </StackPanel>
                            </Border>


                            <Border Style="{StaticResource StatCardStyle}"
                                    Margin="6,0">

                                <StackPanel>

                                    <TextBlock Text="ИНСТРУКТОРЫ"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                    <TextBlock Text="—"
                                               FontSize="32"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColor}"
                                               Margin="0,10,0,0"/>

                                    <TextBlock Text="Зарегистрированные"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                </StackPanel>
                            </Border>


                            <Border Style="{StaticResource StatCardStyle}"
                                    Margin="12,0,0,0">

                                <StackPanel>

                                    <TextBlock Text="ЗАНЯТИЯ"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                    <TextBlock Text="—"
                                               FontSize="32"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColor}"
                                               Margin="0,10,0,0"/>

                                    <TextBlock Text="Всего в расписании"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                </StackPanel>
                            </Border>

                        </UniformGrid>


                        <!-- Быстрый доступ -->
                        <Border Style="{StaticResource StatCardStyle}"
                                Padding="25">

                            <StackPanel>

                                <TextBlock Text="Быстрый доступ"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="Выберите нужный раздел для управления данными."
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextColor}"
                                           TextWrapping="Wrap"/>

                                <WrapPanel Margin="0,20,0,0">

                                    <Button Content="Группы"
                                            Style="{StaticResource AdminActionButtonStyle}"
                                            Margin="0,0,10,10"
                                            Click="Groups_Click"/>
                                    
                                    <Button Content="Ученики"
                                            Style="{StaticResource AdminActionButtonStyle}"
                                            Margin="0,0,10,10"
                                            Click="Students_Click"/>

                                    <Button Content="Инструкторы"
                                            Style="{StaticResource AdminActionButtonStyle}"
                                            Margin="0,0,10,10"
                                            Click="Instructors_Click"/>

                                    <Button Content="Автомобили"
                                            Style="{StaticResource AdminActionButtonStyle}"
                                            Margin="0,0,10,10"
                                            Click="Cars_Click"/>

                                    <Button Content="Расписание"
                                            Style="{StaticResource AdminActionButtonStyle}"
                                            Margin="0,0,10,10"
                                            Click="Lessons_Click"/>

                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>


                <!-- Панель разделов -->
                <Border x:Name="SectionPanel"
                        Visibility="Collapsed"
                        Background="{DynamicResource SurfaceColor}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Padding="30">

                    <StackPanel VerticalAlignment="Top">

                        <TextBlock x:Name="SectionTitle"
                                   Text="Раздел"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                        <TextBlock x:Name="SectionDescription"
                                   Text="Описание раздела"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,10,0,25"
                                   TextWrapping="Wrap"/>

                        <Border Background="{DynamicResource BackgroundColor}"
                                CornerRadius="6"
                                Padding="20">

                            <TextBlock Text="Рабочая область раздела будет добавлена на следующем этапе."
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextColor}"
                                       TextWrapping="Wrap"/>

                        </Border>
                    </StackPanel>
                </Border>


                <!-- Раздел автомобилей -->
                <Grid x:Name="CarsPanel"
                      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- Заголовок и действия -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Автомобили"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>

                            <TextBlock Text="Управление автопарком автошколы"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextColor}"
                                       Margin="0,5,0,0"/>

                            <TextBlock Text="Для множественного удаления зажмите CTRL и выберите нужные записи"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextColor}"
                                       Margin="0,7,0,0"/>

                        </StackPanel>


                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button Content="+ Добавить"
                                    Style="{StaticResource AdminActionButtonStyle}"
                                    Click="AddCar_Click"
                                    Margin="0,0,8,0"/>

                            <Button Content="Удалить"
                                    Style="{StaticResource DeleteActionButtonStyle}"
                                    Click="DeleteCars_Click"
                                    Margin="0,0,8,0"/>

                            <Button Content="Обновить"
                                    Style="{StaticResource LightActionButtonStyle}"
                                    Click="RefreshCars_Click"/>

                        </StackPanel>
                    </Grid>


                    <!-- Таблица автомобилей -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceColor}"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            Padding="10">

                        <DataGrid x:Name="CarsDataGrid"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  HeadersVisibility="Column"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  CanUserSortColumns="True"
                                  CanUserReorderColumns="True"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding [ID]}"
                                                    Width="70"/>

                                <DataGridTextColumn Header="Марка автомобиля"
                                                    Binding="{Binding [Марка]}"
                                                    Width="1.1*"/>

                                <DataGridTextColumn Header="Модель"
                                                    Binding="{Binding [Модель]}"
                                                    Width="1.1*"/>

                                <DataGridTextColumn Header="Государственный номер"
                                                    Binding="{Binding [Гос. номер]}"
                                                    Width="1.4*"/>

                                <DataGridTextColumn Header="Год выпуска"
                                                    Binding="{Binding [Год выпуска]}"
                                                    Width="120"/>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- Раздел учеников -->
                <Grid x:Name="StudentsPanel"
      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок, поиск и действия -->
                    <Grid Grid.Row="0"
          Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Ученики"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>

                            <TextBlock Text="Управление данными учеников автошколы"
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       Margin="0,5,0,15"/>

                            <TextBox x:Name="StudentSearchBox"
                     Width="280"
                     Height="38"
                     HorizontalAlignment="Left"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     FontSize="13"
                     TextChanged="StudentSearchBox_TextChanged"
                     ToolTip="Поиск по ФИО или телефону"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                            <Button Content="+ Добавить"
                    Style="{StaticResource AdminActionButtonStyle}"
                    Click="AddStudent_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Изменить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="EditStudent_Click"
                    Margin="0,0,8,0"/>
                            <Button Content="Платежи ученика"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="StudentPayments_Click"
                    Margin="0,0,8,0"/>
                            <Button Content="Удалить"
                    Style="{StaticResource DeleteActionButtonStyle}"
                    Click="DeleteStudents_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Обновить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="RefreshStudents_Click"/>

                        </StackPanel>
                    </Grid>

                    <!-- Таблица учеников -->
                    <Border Grid.Row="1"
            Background="{DynamicResource SurfaceColor}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            Padding="10">

                        <DataGrid x:Name="StudentsDataGrid"
                  Style="{StaticResource ModernDataGridStyle}"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="True"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                    Binding="{Binding [ID]}"
                                    Width="60"/>

                                <DataGridTextColumn Header="Фамилия"
                                    Binding="{Binding [Фамилия]}"
                                    Width="1.2*"/>

                                <DataGridTextColumn Header="Имя"
                                    Binding="{Binding [Имя]}"
                                    Width="1.1*"/>

                                <DataGridTextColumn Header="Отчество"
                                    Binding="{Binding [Отчество]}"
                                    Width="1.2*"/>

                                <DataGridTextColumn Header="Телефон"
                                    Binding="{Binding [Телефон]}"
                                    Width="1.3*"/>

                                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding [Статус]}"
                                    Width="1.1*"/>

                                <DataGridTextColumn Header="Группа"
                                    Binding="{Binding [Группа]}"
                                    Width="1.2*"/>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </Grid>

                <!-- Раздел групп -->
                <Grid x:Name="GroupsPanel"
                       Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок и действия -->
                    <Grid Grid.Row="0"
          Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Учебные группы"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>

                            <TextBlock Text="Управление учебными группами автошколы"
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       Margin="0,5,0,15"/>

                            <TextBox x:Name="GroupSearchBox"
                     Width="280"
                     Height="38"
                     HorizontalAlignment="Left"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     FontSize="13"
                     TextChanged="GroupSearchBox_TextChanged"
                     ToolTip="Поиск по названию группы"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                            <Button Content="+ Добавить"
                    Style="{StaticResource AdminActionButtonStyle}"
                    Click="AddGroup_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Изменить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="EditGroup_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Удалить"
                    Style="{StaticResource DeleteActionButtonStyle}"
                    Click="DeleteGroup_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Обновить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="RefreshGroups_Click"/>

                        </StackPanel>
                    </Grid>

                    <!-- Таблица групп -->
                    <Border Grid.Row="1"
            Background="{DynamicResource SurfaceColor}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            Padding="10">

                        <DataGrid x:Name="GroupsDataGrid"
                  Style="{StaticResource ModernDataGridStyle}"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="True"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                    Binding="{Binding [ID]}"
                                    Width="80"/>
                                <DataGridTextColumn Header="Название группы"
                                    Binding="{Binding [Название группы]}"
                                    Width="2*"/>
                                <DataGridTextColumn Header="Количество учеников"
                                    Binding="{Binding [Количество учеников]}"
                                    Width="1.2*"/>
                                <DataGridTextColumn Header="Дата начала"
                                    Binding="{Binding [Дата начала], StringFormat={}{0:dd.MM.yyyy}}"
                                    Width="1.3*"/>

                                <DataGridTextColumn Header="Дата окончания"
                                    Binding="{Binding [Дата окончания], StringFormat={}{0:dd.MM.yyyy}}"
                                    Width="1.3*"/>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </Grid>
                <!-- Раздел платежей -->
                <Grid x:Name="PaymentsPanel"
      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок, поиск и действия -->
                    <Grid Grid.Row="0"
          Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Платежи"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>

                            <TextBlock Text="Учёт платежей и оплат учеников автошколы"
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       Margin="0,5,0,15"/>

                            <TextBox x:Name="PaymentSearchBox"
                     Width="280"
                     Height="38"
                     HorizontalAlignment="Left"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     FontSize="13"
                     TextChanged="PaymentSearchBox_TextChanged"
                     ToolTip="Поиск по ФИО ученика"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                            <Button Content="+ Добавить"
                    Style="{StaticResource AdminActionButtonStyle}"
                    Click="AddPayment_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Изменить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="EditPayment_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Удалить"
                    Style="{StaticResource DeleteActionButtonStyle}"
                    Click="DeletePayments_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Обновить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="RefreshPayments_Click"/>

                        </StackPanel>
                    </Grid>

                    <!-- Таблица платежей -->
                    <Border Grid.Row="1"
            Background="{DynamicResource SurfaceColor}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            Padding="10">

                        <DataGrid x:Name="PaymentsDataGrid"
                  Style="{StaticResource ModernDataGridStyle}"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="True"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                    Binding="{Binding [ID]}"
                                    Width="70"/>

                                <DataGridTextColumn Header="Ученик"
                                    Binding="{Binding [Ученик]}"
                                    Width="2*"/>

                                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding [Сумма], StringFormat={}{0:N2} ₽}"
                                    Width="1.2*"/>

                                <DataGridTextColumn Header="Дата платежа"
                                    Binding="{Binding [Дата платежа], StringFormat={}{0:dd.MM.yyyy}}"
                                    Width="1.4*"/>

                                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding [Статус]}"
                                    Width="1.2*"/>

                                <DataGridTextColumn Header="Телефон"
                                    Binding="{Binding [Телефон]}"
                                    Width="1.3*"/>

                                <DataGridTextColumn Header="Группа"
                                    Binding="{Binding [Группа]}"
                                    Width="1.3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </Grid>

                <!--/таблица инструктора-->

                <Grid x:Name="InstructorsPanel" Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,22">
                        <TextBlock Text="Инструкторы"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextColor}"/>

                        <TextBlock Text="Управление инструкторами автошколы"
                   FontSize="14"
                   Foreground="{DynamicResource SecondaryTextColor}"
                   Margin="0,7,0,0"/>
                    </StackPanel>

                    <!-- Поиск и основные действия -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InstructorSearchBox"
                 Height="42"
                 VerticalContentAlignment="Center"
                 Padding="12,0"
                 FontSize="14"
                 Background="{DynamicResource InputBackgroundColor}"
                 Foreground="{DynamicResource TextColor}"
                 BorderBrush="{DynamicResource BorderColor}"
                 TextChanged="InstructorSearchBox_TextChanged"/>

                        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">

                            <Button Content="Добавить"
                    Style="{StaticResource AdminActionButtonStyle}"
                    Click="AddInstructor_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Изменить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="EditInstructor_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Удалить"
                    Style="{StaticResource DeleteActionButtonStyle}"
                    Click="DeleteInstructors_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Обновить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="RefreshInstructors_Click"/>

                        </StackPanel>
                    </Grid>

                    <!-- Управление учётными записями -->
                    <Border Grid.Row="2"
            Background="{DynamicResource SurfaceColor}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Margin="0,0,0,16">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Управление доступом"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"/>

                                <TextBlock Text="Действия с учётной записью выбранного инструктора"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                        Orientation="Horizontal">

                                <Button Content="Создать приглашение"
                        Style="{StaticResource AdminActionButtonStyle}"
                        Click="CreateInvitation_Click"
                        Margin="0,0,8,0"/>

                                <Button Content="Изменить доступ"
                        Style="{StaticResource LightActionButtonStyle}"
                        Click="ToggleInstructorAccount_Click"
                        Margin="0,0,8,0"/>

                                <Button Content="Удалить учётную запись"
                        Style="{StaticResource DeleteActionButtonStyle}"
                        Click="DeleteInstructorAccount_Click"/>

                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Таблица инструкторов -->
                    <DataGrid x:Name="InstructorsDataGrid"
              Grid.Row="3"
              Style="{StaticResource ModernDataGridStyle}"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserSortColumns="True"
              CanUserReorderColumns="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                Binding="{Binding [ID]}"
                                Width="60"/>

                            <DataGridTextColumn Header="Фамилия"
                                Binding="{Binding [Фамилия]}"
                                Width="1.2*"/>

                            <DataGridTextColumn Header="Имя"
                                Binding="{Binding [Имя]}"
                                Width="1.2*"/>

                            <DataGridTextColumn Header="Отчество"
                                Binding="{Binding [Отчество]}"
                                Width="1.2*"/>

                            <DataGridTextColumn Header="Телефон"
                                Binding="{Binding [Телефон]}"
                                Width="1.2*"/>

                            <DataGridTextColumn Header="Регистрация"
                                Binding="{Binding [Регистрация]}"
                                Width="1.3*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

                <Grid x:Name="LessonsPanel" Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,22">

                        <TextBlock Text="Занятия"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextColor}"/>

                        <TextBlock Text="Управление расписанием занятий автошколы"
                   FontSize="14"
                   Foreground="{DynamicResource SecondaryTextColor}"
                   Margin="0,7,0,0"/>

                    </StackPanel>

                    <!-- Поиск и действия -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="LessonSearchBox"
                 Height="42"
                 VerticalContentAlignment="Center"
                 Padding="12,0"
                 FontSize="14"
                 Background="{DynamicResource InputBackgroundColor}"
                 Foreground="{DynamicResource TextColor}"
                 BorderBrush="{DynamicResource BorderColor}"
                 TextChanged="LessonSearchBox_TextChanged"/>

                        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">

                            <Button Content="Добавить"
                    Style="{StaticResource AdminActionButtonStyle}"
                    Click="AddLesson_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Изменить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="EditLesson_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Удалить"
                    Style="{StaticResource DeleteActionButtonStyle}"
                    Click="DeleteLessons_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Обновить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="RefreshLessons_Click"/>

                        </StackPanel>
                    </Grid>

                    <!-- Таблица занятий -->
                    <DataGrid x:Name="LessonsDataGrid"
              Grid.Row="2"
              Style="{StaticResource ModernDataGridStyle}"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              CanUserSortColumns="True"
              CanUserReorderColumns="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                Binding="{Binding [ID]}"
                                Width="55"/>

                            <DataGridTextColumn Header="Дата"
                                Binding="{Binding [Дата], StringFormat={}{0:dd.MM.yyyy}}"
                                Width="110"/>

                            <DataGridTextColumn Header="Время"
                                Binding="{Binding [Время]}"
                                Width="85"/>

                            <DataGridTextColumn Header="Ученик"
                                Binding="{Binding [Ученик]}"
                                Width="1.3*"/>

                            <DataGridTextColumn Header="Инструктор"
                                Binding="{Binding [Инструктор]}"
                                Width="1.3*"/>

                            <DataGridTextColumn Header="Автомобиль"
                                Binding="{Binding [Автомобиль]}"
                                Width="1.2*"/>

                            <DataGridTextColumn Header="Статус"
                                Binding="{Binding [Статус]}"
                                Width="130"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>



            </Grid>
        </Grid>
    </Grid>
</Window>
