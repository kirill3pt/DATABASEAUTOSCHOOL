                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding [Название группы]}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>

                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="ДАТА ЭКЗАМЕНА"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           Margin="0,0,0,7"/>


                                    <Grid x:Name="ExamDateField">

                                        <Border Height="40"
            Background="#FBFAF7"
            BorderBrush="#E2E0D8"
            BorderThickness="1"
            CornerRadius="6"/>

