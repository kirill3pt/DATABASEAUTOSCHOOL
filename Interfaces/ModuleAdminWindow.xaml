<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.ModuleAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автошкола — Панель администратора"
        Height="780"
        Width="1250"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}"
        Foreground="{DynamicResource TextColor}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/AdminStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Боковое меню -->
        <Border Grid.Column="0"
                Background="{DynamicResource ForestCharcoal}">

            <DockPanel Margin="20">

                <!-- Нижняя часть меню -->
                <StackPanel DockPanel.Dock="Bottom">
                    <!-- Дополнительные разделы -->
                    <TextBlock Text="ДОПОЛНИТЕЛЬНО"
                               Foreground="#A8B5A5"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="10,10,0,8"/>
                    <Border Height="1"
                            Background="#536158"
                            Margin="0,0,0,0"/>
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Settings_Click" Cursor="Hand">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Настройки"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="About_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="О программе"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}"
                            Foreground="#D99B8F"
                            Click="Logout_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Выйти"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>


                <!-- Верхняя часть меню -->
                <StackPanel>

                    <!-- Название приложения -->
                    <StackPanel Margin="5,8,0,24">

                        <TextBlock Text="АВТОШКОЛА"
                                   Foreground="#F3F1EB"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Text="ПАНЕЛЬ УПРАВЛЕНИЯ"
                                   Foreground="#A8B5A5"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- Главная -->
                    <TextBlock Text="ГЛАВНОЕ"
                               Foreground="#A8B5A5"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="10,0,0,8"/>

                    <Button x:Name="DashboardButton"
                            Style="{StaticResource NavButtonStyle}"
                            Background="{DynamicResource Sage}"
                            Foreground="{DynamicResource ForestCharcoal}"
                            Click="Dashboard_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Главная"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Управление данными -->
                    <TextBlock Text="УПРАВЛЕНИЕ"
                               Foreground="#A8B5A5"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="10,10,0,8"/>
                    
                    <Button x:Name="GroupsButton"
                    Style="{StaticResource NavButtonStyle}"
                    Click="Groups_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Группы"
                               VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="StudentsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Students_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ученики"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>



                    <Button x:Name="InstructorsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Instructors_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Инструкторы"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CarsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Cars_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Автомобили"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="LessonsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Lessons_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Расписание"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PaymentsButton"
        Style="{StaticResource NavButtonStyle}"
        Click="Payments_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Платежи"
                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>



                    <Button x:Name="ReportsButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Reports_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Отчёты"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>


        <!-- Основная область -->
        <Grid Grid.Column="1"
              Margin="32,25,32,25">



            <!-- Содержимое выбранного раздела -->
            <Grid Grid.Row="1"
                  Margin="0,20,0,0">


                <!-- Главная страница -->

                <ScrollViewer x:Name="DashboardPanel"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <!-- Заголовок -->
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Заголовок слева -->
                            <StackPanel Grid.Column="0"
                VerticalAlignment="Center">

                                <TextBlock Text="ГЛАВНАЯ / ОБЗОР"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="{DynamicResource SecondaryTextColor}"/>

                                <TextBlock Text="Рабочая панель"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextColor}"
                   Margin="0,5,0,0"/>

                                <TextBlock Text="Основная информация и инструменты управления"
                   FontSize="13"
                   Foreground="{DynamicResource SecondaryTextColor}"
                   Margin="0,5,0,0"/>

                            </StackPanel>

                            <!-- Статус справа -->
                            <Border Grid.Column="1"
            Background="{DynamicResource SurfaceColor}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="15,9"
            VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal">

                                    <Ellipse Width="8"
                     Height="8"
                     Fill="#7E9B7B"
                     VerticalAlignment="Center"
                     Margin="0,0,9,0"/>

                                    <TextBlock Text="Администратор"
                       Foreground="{DynamicResource TextColor}"
                       FontSize="12"
                       FontWeight="SemiBold"/>

                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Статистика -->
                        <Grid Margin="0,0,0,14">

                            <TextBlock Text="Общая статистика"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>

                        </Grid>
                        <UniformGrid Columns="3"
                     Margin="0,0,0,28">

                            <Border Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="19"
                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="01 / УЧЕНИКИ"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                    <TextBlock x:Name="StudentsCountText"
                               Text="0"
                               FontSize="34"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               Margin="0,14,0,3"/>

                                    <TextBlock Text="Всего в системе"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                </StackPanel>
                            </Border>


                            <Border Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="19"
                    Margin="4,0">

                                <StackPanel>

                                    <TextBlock Text="02 / ИНСТРУКТОРЫ"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                    <TextBlock x:Name="DashboardInstructorsCountText"
           Text="0"
           FontSize="34"
           FontWeight="SemiBold"
           Foreground="{DynamicResource TextColor}"
           Margin="0,14,0,3"/>

                                    <TextBlock Text="Зарегистрированные"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                </StackPanel>
                            </Border>


                            <Border Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="19"
                    Margin="8,0,0,0">

                                <StackPanel>

                                    <TextBlock Text="03 / ЗАНЯТИЯ"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                    <TextBlock x:Name="DashboardLessonsCountText"
           Text="0"
           FontSize="34"
           FontWeight="SemiBold"
           Foreground="{DynamicResource TextColor}"
           Margin="0,14,0,3"/>

                                    <TextBlock Text="Всего в расписании"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextColor}"/>

                                </StackPanel>
                            </Border>

                        </UniformGrid>


                        <!-- Раздел управления -->
                        <Grid Margin="0,0,0,15">

                            <StackPanel>

                                <TextBlock Text="Управление"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"/>

                                <TextBlock Text="Выберите необходимый раздел"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           Margin="0,5,0,0"/>

                            </StackPanel>
                        </Grid>


                        <!-- Плитки -->
                        <UniformGrid Columns="2">

                            <!-- Ученики -->
                            <Button Style="{StaticResource DashboardTileButtonStyle}"
                    Margin="0,0,8,8"
                    Click="Students_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="46"
                            Height="46"
                            Background="{DynamicResource MutedSurfaceColor}"
                            CornerRadius="10">

                                        <TextBlock Text="01"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                Margin="14,0,5,0"
                                VerticalAlignment="Center">

                                        <TextBlock Text="Ученики"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                                        <TextBlock Text="Учет и данные учащихся"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,5,0,0"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                               Text="→"
                               FontSize="20"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               VerticalAlignment="Center"/>

                                </Grid>
                            </Button>


                            <!-- Инструкторы -->
                            <Button Style="{StaticResource DashboardTileButtonStyle}"
                    Margin="8,0,0,8"
                    Click="Instructors_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="46"
                            Height="46"
                            Background="{DynamicResource MutedSurfaceColor}"
                            CornerRadius="10">

                                        <TextBlock Text="02"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                Margin="14,0,5,0"
                                VerticalAlignment="Center">

                                        <TextBlock Text="Инструкторы"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                                        <TextBlock Text="Состав и учет инструкторов"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,5,0,0"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                               Text="→"
                               FontSize="20"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               VerticalAlignment="Center"/>

                                </Grid>
                            </Button>


                            <!-- Автомобили -->
                            <Button Style="{StaticResource DashboardTileButtonStyle}"
                    Margin="0,8,8,8"
                    Click="Cars_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="46"
                            Height="46"
                            Background="{DynamicResource MutedSurfaceColor}"
                            CornerRadius="10">

                                        <TextBlock Text="03"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                Margin="14,0,5,0"
                                VerticalAlignment="Center">

                                        <TextBlock Text="Автомобили"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                                        <TextBlock Text="Управление автопарком"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,5,0,0"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                               Text="→"
                               FontSize="20"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               VerticalAlignment="Center"/>

                                </Grid>
                            </Button>


                            <!-- Расписание -->
                            <Button Style="{StaticResource DashboardTileButtonStyle}"
                    Margin="8,8,0,8"
                    Click="Lessons_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="46"
                            Height="46"
                            Background="{DynamicResource MutedSurfaceColor}"
                            CornerRadius="10">

                                        <TextBlock Text="04"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                Margin="14,0,5,0"
                                VerticalAlignment="Center">

                                        <TextBlock Text="Расписание"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                                        <TextBlock Text="Занятия и записи"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,5,0,0"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                               Text="→"
                               FontSize="20"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               VerticalAlignment="Center"/>

                                </Grid>
                            </Button>


                            <!-- Группы -->
                            <Button Style="{StaticResource DashboardTileButtonStyle}"
                    Margin="0,8,8,8"
                    Click="Groups_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="46"
                            Height="46"
                            Background="{DynamicResource MutedSurfaceColor}"
                            CornerRadius="10">

                                        <TextBlock Text="05"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                Margin="14,0,5,0"
                                VerticalAlignment="Center">

                                        <TextBlock Text="Группы"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                                        <TextBlock Text="Учебные группы и наборы"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,5,0,0"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                               Text="→"
                               FontSize="20"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               VerticalAlignment="Center"/>

                                </Grid>
                            </Button>


                            <!-- Платежи -->
                            <Button Style="{StaticResource DashboardTileButtonStyle}"
                    Margin="8,8,0,8"
                    Click="Payments_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="46"
                            Height="46"
                            Background="{DynamicResource MutedSurfaceColor}"
                            CornerRadius="10">

                                        <TextBlock Text="06"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                Margin="14,0,5,0"
                                VerticalAlignment="Center">

                                        <TextBlock Text="Платежи"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                                        <TextBlock Text="Учет оплат учеников"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,5,0,0"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                               Text="→"
                               FontSize="20"
                               Foreground="{DynamicResource SecondaryTextColor}"
                               VerticalAlignment="Center"/>

                                </Grid>
                            </Button>

                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>


                <!-- Панель разделов -->
                <Border x:Name="SectionPanel"
                        Visibility="Collapsed"
                        Background="{DynamicResource SurfaceColor}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        Padding="30">

                    <StackPanel VerticalAlignment="Top">

                        <TextBlock x:Name="SectionTitle"
                                   Text="Раздел"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"/>

                        <TextBlock x:Name="SectionDescription"
                                   Text="Описание раздела"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextColor}"
                                   Margin="0,10,0,25"
                                   TextWrapping="Wrap"/>

                        <Border Background="{DynamicResource BackgroundColor}"
                                CornerRadius="6"
                                Padding="20">

                            <TextBlock Text="Рабочая область раздела будет добавлена на следующем этапе."
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextColor}"
                                       TextWrapping="Wrap"/>

                        </Border>
                    </StackPanel>
                </Border>
                

                <!-- Раздел автомобилей -->
                <Grid x:Name="CarsPanel"
                      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- Заголовок и действия -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Автомобили"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextColor}"/>

                            <TextBlock Text="Управление автопарком автошколы"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextColor}"
                                       Margin="0,5,0,0"/>

                            <TextBlock Text="Для множественного удаления зажмите CTRL и выберите нужные записи"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextColor}"
                                       Margin="0,7,0,0"/>

                        </StackPanel>


                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button Content="+ Добавить"
                                    Style="{StaticResource AdminActionButtonStyle}"
                                    Click="AddCar_Click"
                                    Margin="0,0,8,0"/>

                            <Button Content="Удалить"
                                    Style="{StaticResource DeleteActionButtonStyle}"
                                    Click="DeleteCars_Click"
                                    Margin="0,0,8,0"/>

                            <Button Content="Обновить"
                                    Style="{StaticResource LightActionButtonStyle}"
                                    Click="RefreshCars_Click"/>

                        </StackPanel>
                    </Grid>


                    <!-- Таблица автомобилей -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceColor}"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            Padding="10">

                        <DataGrid x:Name="CarsDataGrid"
                            Style="{StaticResource ModernDataGridStyle}"
                            HeadersVisibility="Column"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="Extended"
                            CanUserSortColumns="True"
                            CanUserReorderColumns="True">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding [ID]}"
                                                    Width="70"/>

                                <DataGridTextColumn Header="Марка автомобиля"
                                                    Binding="{Binding [Марка]}"
                                                    Width="1.1*"/>

                                <DataGridTextColumn Header="Модель"
                                                    Binding="{Binding [Модель]}"
                                                    Width="1.1*"/>

                                <DataGridTextColumn Header="Государственный номер"
                                                    Binding="{Binding [Гос. номер]}"
                                                    Width="1.4*"/>

                                <DataGridTextColumn Header="Год выпуска"
                                                    Binding="{Binding [Год выпуска]}"
                                                    Width="120"/>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- Раздел учеников -->
                <Grid x:Name="StudentsPanel"
      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок, поиск и действия -->
                    <Grid Grid.Row="0"
          Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Ученики"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>

                            <TextBlock Text="Управление данными учеников автошколы"
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       Margin="0,5,0,15"/>

                            <TextBox x:Name="StudentSearchBox"
                     Width="280"
                     Height="38"
                     HorizontalAlignment="Left"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     FontSize="13"
                     TextChanged="StudentSearchBox_TextChanged"
                     ToolTip="Поиск по ФИО или телефону"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                            <Button Content="+ Добавить"
                    Style="{StaticResource AdminActionButtonStyle}"
                    Click="AddStudent_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Изменить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="EditStudent_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Платежи ученика"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="StudentPayments_Click"
                    Margin="0,0,8,0"/>
                            <Button Content="Удалить"
                    Style="{StaticResource DeleteActionButtonStyle}"
                    Click="DeleteStudents_Click"
                    Margin="0,0,8,0"/>

                            <Button Content="Обновить"
                    Style="{StaticResource LightActionButtonStyle}"
                    Click="RefreshStudents_Click"/>

                        </StackPanel>
                    </Grid>

                    <!-- Таблица учеников -->
                    <Border Grid.Row="1"
                               Background="{DynamicResource SurfaceColor}"
