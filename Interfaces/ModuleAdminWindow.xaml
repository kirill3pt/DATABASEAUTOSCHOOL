                            <TextBlock Text="Платежи"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>

                            <TextBlock Text="Учёт платежей и оплат учеников автошколы"
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextColor}"
                       Margin="0,5,0,15"/>

                            <TextBox x:Name="PaymentSearchBox"
