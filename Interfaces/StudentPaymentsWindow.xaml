<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.StudentPaymentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История платежей ученика"
        Width="850"
        Height="570"
        MinWidth="750"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundColor}"
        FontFamily="Segoe UI">
    <Window.Resources>

        <!-- Таблица -->
        <Style x:Key="ModernDataGridStyle"
               TargetType="{x:Type DataGrid}">

            <Setter Property="Background"
                    Value="{DynamicResource SurfaceColor}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground"
                    Value="{DynamicResource SurfaceColor}"/>
            <Setter Property="AlternatingRowBackground"
                    Value="#F4F3EE"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="{DynamicResource BorderColor}"/>
            <Setter Property="VerticalGridLinesBrush"
                    Value="Transparent"/>
            <Setter Property="RowHeight" Value="56"/>
            <Setter Property="ColumnHeaderHeight" Value="46"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>

            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridColumnHeader}">

                        <Setter Property="Background"
                                Value="{DynamicResource MutedSurfaceColor}"/>
                        <Setter Property="Foreground"
                                Value="{DynamicResource SecondaryTextColor}"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource BorderColor}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Cursor" Value="Hand"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            RecognizesAccessKey="True"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EAE8E0"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextColor}"/>
                            </Trigger>
                        </Style.Triggers>

                    </Style>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="История платежей"
                   FontSize="25"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextColor}"/>

            <TextBlock x:Name="StudentNameText"
                   FontSize="14"
                   Foreground="{DynamicResource SecondaryTextColor}"
                   Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Финансовая сводка -->
        <Border Grid.Row="1"
            Background="{DynamicResource SurfaceColor}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18"
            Margin="0,0,0,18">

            <StackPanel>

                <Grid Margin="0,0,0,15">
                    <TextBlock Text="Финансовое состояние"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           VerticalAlignment="Center"/>

                    <TextBlock x:Name="FinancialStatusText"
                           Text="Не оплачено"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextColor}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Стоимость обучения"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextColor}"/>

                        <TextBlock x:Name="TuitionCostText"
                               Text="0,00 ₽"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Оплачено"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextColor}"/>

                        <TextBlock x:Name="PaidAmountText"
                               Text="0,00 ₽"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Осталось"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextColor}"/>

                        <TextBlock x:Name="RemainingAmountText"
                               Text="0,00 ₽"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"
                               Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="PaymentProgressBar"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Height="7"
                         Margin="0,16,0,6"
                         Background="{DynamicResource MutedSurfaceColor}"
                         Foreground="{DynamicResource Sage}"
                         BorderThickness="0"/>

                <TextBlock x:Name="PaymentProgressText"
                       Text="Оплачено 0%"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryTextColor}"/>

            </StackPanel>
        </Border>

        <!-- История платежей -->
        
<Border Grid.Row="2"
        Background="{DynamicResource SurfaceColor}"
        CornerRadius="8"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        Padding="10">

    <DataGrid x:Name="StudentPaymentsDataGrid"
              Style="{StaticResource ModernDataGridStyle}"
              HeadersVisibility="Column"
              SelectionMode="Single"
              CanUserSortColumns="True"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              IsReadOnly="True"
              AutoGenerateColumns="False"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto">

        <DataGrid.Columns>

            <DataGridTextColumn Header="№"
                                Binding="{Binding [ID]}"
                                Width="65"/>

            <DataGridTextColumn Header="Сумма платежа"
                                Binding="{Binding [Сумма], StringFormat={}{0:N2} ₽}"
                                Width="2*"/>

            <DataGridTextColumn Header="Дата платежа"
                                Binding="{Binding [Дата платежа], StringFormat={}{0:dd.MM.yyyy}}"
                                Width="1.5*"/>

            <DataGridTextColumn Header="Статус"
                                Binding="{Binding [Статус]}"
                                Width="1.5*"/>

        </DataGrid.Columns>
    </DataGrid>
</Border>


        <!-- Кнопка закрытия -->
        <Button Grid.Row="3"
            Content="Закрыть"
            Width="110"
            Height="40"
            HorizontalAlignment="Right"
            Margin="0,18,0,0"
            Background="{DynamicResource Sage}"
            Foreground="{DynamicResource TextColor}"
            BorderThickness="0"
            Cursor="Hand"
            Click="Close_Click"/>

    </Grid>

</Window>
