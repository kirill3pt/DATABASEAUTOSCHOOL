<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.AddGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление группы"
        Width="460"
        Height="500"
        MinWidth="460"
        MinHeight="500"
        MaxWidth="460"
        MaxHeight="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="CalendarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FAF9F6"/>
            <Setter Property="Foreground" Value="#293330"/>
            <Setter Property="BorderBrush" Value="#E2E0D8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#EAE8E0"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#A8B5A5"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="#B8B8B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Новая группа"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextColor}"/>

            <TextBlock Text="Заполните информацию об учебной группе"
                       FontSize="13"
                       Foreground="{StaticResource SecondaryTextColor}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">

            <TextBlock Text="Название группы"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="GroupNameBox"
                     Height="40"
                     FontSize="14"
                     Margin="0,0,0,15"
                     Background="#FBFAF7"
                     Foreground="#293330"
                     BorderBrush="#E2E0D8"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     MaxLength="100"/>

            <TextBlock Text="Дата начала"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <Grid x:Name="StartDateField" Margin="0,0,0,15">
                <Border Height="42"
                        Background="#FBFAF7"
                        BorderBrush="#E2E0D8"
                        BorderThickness="1"
                        CornerRadius="6"/>

                <Button Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="StartCalendarToggleButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="StartDateText"
                                   Grid.Column="0"
                                   Text="Выберите дату"
                                   FontSize="14"
                                   Foreground="#737D76"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="12,0,0,0"/>

                        <TextBlock Grid.Column="1"
                                   Text="▦"
                                   FontSize="19"
                                   Foreground="#737D76"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Popup x:Name="StartCalendarPopup"
                       PlacementTarget="{Binding ElementName=StartDateField}"
                       Placement="Bottom"
                       VerticalOffset="5"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">

                    <Border Width="310"
                            Background="#FAF9F6"
                            BorderBrush="#E2E0D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15">

                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="‹"
                                        FontSize="24"
                                        Style="{StaticResource CalendarButtonStyle}"
                                        Click="StartPreviousMonth_Click"/>

                                <TextBlock x:Name="StartCalendarMonthText"
                                           Grid.Column="1"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#293330"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="2"
                                        Content="›"
                                        FontSize="24"
                                        Style="{StaticResource CalendarButtonStyle}"
                                        Click="StartNextMonth_Click"/>
                            </Grid>

                            <UniformGrid Columns="7" Margin="0,0,0,7">
                                <TextBlock Text="Пн" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Вт" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Ср" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Чт" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Пт" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Сб" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Вс" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                            </UniformGrid>

                            <UniformGrid x:Name="StartCalendarDaysPanel"
                                         Columns="7"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <TextBlock Text="Дата окончания"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <Grid x:Name="EndDateField">
                <Border Height="42"
                        Background="#FBFAF7"
                        BorderBrush="#E2E0D8"
                        BorderThickness="1"
                        CornerRadius="6"/>

                <Button Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="EndCalendarToggleButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="EndDateText"
                                   Grid.Column="0"
                                   Text="Выберите дату"
                                   FontSize="14"
                                   Foreground="#737D76"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="12,0,0,0"/>

                        <TextBlock Grid.Column="1"
                                   Text="▦"
                                   FontSize="19"
                                   Foreground="#737D76"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Popup x:Name="EndCalendarPopup"
                       PlacementTarget="{Binding ElementName=EndDateField}"
                       Placement="Bottom"
                       VerticalOffset="5"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">

                    <Border Width="310"
                            Background="#FAF9F6"
                            BorderBrush="#E2E0D8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15">

                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="‹"
                                        FontSize="24"
                                        Style="{StaticResource CalendarButtonStyle}"
                                        Click="EndPreviousMonth_Click"/>

                                <TextBlock x:Name="EndCalendarMonthText"
                                           Grid.Column="1"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#293330"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="2"
                                        Content="›"
                                        FontSize="24"
                                        Style="{StaticResource CalendarButtonStyle}"
                                        Click="EndNextMonth_Click"/>
                            </Grid>

                            <UniformGrid Columns="7" Margin="0,0,0,7">
                                <TextBlock Text="Пн" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Вт" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Ср" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Чт" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Пт" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Сб" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Вс" Foreground="#737D76" TextAlignment="Center" FontSize="12"/>
                            </UniformGrid>

                            <UniformGrid x:Name="EndCalendarDaysPanel"
                                         Columns="7"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Отмена"
                    Width="105"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="{DynamicResource Sage}"
                    Foreground="{StaticResource TextColor}"
                    BorderThickness="0"
                    IsCancel="True"
                    Cursor="Hand"/>

            <Button Grid.Column="2"
                    Content="Добавить"
                    Width="120"
                    Height="40"
                    Background="{StaticResource PrimaryColor}"
                    Foreground="#FAF9F6"
                    BorderThickness="0"
                    Click="Save_Click"
                    Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
