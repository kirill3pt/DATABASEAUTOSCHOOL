<Window x:Class="DATABASEAUTOSCHOOL.Interfaces.AddGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление группы"
        Width="460"
        Height="500"
        MinWidth="460"
        MinHeight="500"
        MaxWidth="460"
        MaxHeight="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}"
        FontFamily="Segoe UI">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">

            <TextBlock Text="Новая группа"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextColor}"/>

            <TextBlock Text="Заполните информацию об учебной группе"
                       FontSize="13"
                       Foreground="{StaticResource SecondaryTextColor}"
                       Margin="0,6,0,0"/>

        </StackPanel>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="1">

            <TextBlock Text="Название группы"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="GroupNameBox"
                     Height="40"
                     FontSize="14"
                     Margin="0,0,0,15"
                     Background="White"
                     Foreground="#202B46"
                     BorderBrush="#D5DCE8"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     MaxLength="100"
                     IsReadOnly="False"
                     IsEnabled="True"/>

            <TextBlock Text="Дата начала"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <DatePicker x:Name="StartDatePicker"
                        Height="40"
                        FontSize="14"
                        Margin="0,0,0,15"
                        Background="White"
                        Foreground="#202B46"
                        BorderBrush="#D5DCE8"
                        BorderThickness="1"
                        VerticalContentAlignment="Center"
                        SelectedDateFormat="Short"/>

            <TextBlock Text="Дата окончания"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,0,0,6"/>

            <DatePicker x:Name="EndDatePicker"
                        Height="40"
                        FontSize="14"
                        Background="White"
                        Foreground="#202B46"
                        BorderBrush="#D5DCE8"
                        BorderThickness="1"
                        VerticalContentAlignment="Center"
                        SelectedDateFormat="Short"/>

        </StackPanel>

        <!-- Кнопки -->
        <Grid Grid.Row="2" Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Отмена"
                    Width="105"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="{DynamicResource Sage}"
                    Foreground="{StaticResource TextColor}"
                    BorderThickness="0"
                    IsCancel="True"
                    Cursor="Hand"/>

            <Button Grid.Column="2"
                    Content="Добавить"
                    Width="120"
                    Height="40"
                    Background="{StaticResource PrimaryColor}"
                    Foreground="#FAF9F6"
                    BorderThickness="0"
                    Click="Save_Click"
                    Cursor="Hand"/>

        </Grid>

    </Grid>

</Window>
